#!/bin/bash
#
# hipcc wrapper that compiles a single source file for several GPU
# architectures in parallel.
#
# hipcc/clang walks its --offload-arch list sequentially: for a translation
# unit with N architectures the device passes run one after the other, so the
# wall time is the sum over architectures.  Those per-architecture device
# compilations are independent, so this wrapper drives the same pipeline the
# driver uses internally, but concurrently:
#
#   1. one  --offload-host-only    compile  -> host object      (once)
#   2. N    --offload-device-only  compiles -> per-arch bitcode (in parallel)
#   3. clang-offload-bundler       -type=o  -> the final object
#
# Everything is done with the compiler's own interfaces: no ELF surgery, and
# the host translation unit is compiled once rather than once per architecture.
#
# The exact bundler binary, the -targets list and the compilation-unit id are
# not guessed: they are read back from the driver itself via -###, so the
# result matches what a plain multi-arch hipcc would have produced.
#
# Under a GNU Make jobserver the wrapper is a cooperative client: it owns one
# implicit slot (the recipe make already accounted for) and acquires a token per
# ADDITIONAL concurrent job, so a -jN build does not turn into N*archs processes.
# Without a jobserver it behaves as before and runs all architectures at once.
#
# Tokens are re-checked every HIPCC_PARALLEL_JOBSERVER_RETRY seconds while an
# architecture is still queued, not just at startup: a TU that begins during a
# busy stretch would otherwise stay single-threaded for its whole life, even
# after the rest of the build drains and leaves the machine idle.
#
# Ctrl+C takes the sub-compiles with it.  Each job runs in its own process
# group, so the wrapper can signal a whole hipcc/clang/cc1 tree, wait for it to
# die, and only then give back jobserver tokens and remove its temporaries.
#
# The wrapper falls back to plain hipcc whenever it is not confident it can
# reproduce the same result (linking, preprocessing, fewer than two
# architectures, anything unexpected in the -### output, ...).
#
# Environment:
#   HIPCC_REAL             path to the real hipcc (default: next hipcc in PATH)
#   HIPCC_PARALLEL_JOBS    max concurrent device compiles (default: all, or as
#                          many as the jobserver grants)
#   HIPCC_PARALLEL_JOBSERVER  0 to ignore the GNU Make jobserver
#   HIPCC_PARALLEL_JOBSERVER_RETRY
#                          seconds between attempts to take another jobserver
#                          token while an architecture is still queued
#                          (default 10; 0 decides once at startup)
#   HIPCC_PARALLEL_DEDUP   0 to print every job's diagnostics verbatim
#   HIPCC_PARALLEL_DEBUG   1 to trace what the wrapper decides to do
#   HIPCC_PARALLEL_OFF     1 to disable the wrapper entirely
#
set -uo pipefail

warn() { printf 'hipcc-parallel: %s\n' "$*" >&2; }
debug() { [ "${HIPCC_PARALLEL_DEBUG:-0}" = 1 ] && warn "$*"; return 0; }

# ---------------------------------------------------------------- real hipcc
find_real_hipcc() {
    if [ -n "${HIPCC_REAL:-}" ]; then printf '%s' "$HIPCC_REAL"; return; fi
    local self_dir this
    self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
    while IFS= read -r this; do
        [ -x "$this" ] || continue
        [ "$(cd -- "$(dirname -- "$this")" && pwd -P)" = "$self_dir" ] && continue
        printf '%s' "$this"; return
    done < <(type -ap hipcc)
}
REAL_HIPCC=$(find_real_hipcc)
if [ -z "$REAL_HIPCC" ]; then
    warn "cannot locate the real hipcc; set HIPCC_REAL"
    exit 127
fi

# $1 is the reason, the rest are the original arguments
run_plain() { local reason=$1; shift; debug "passthrough: $reason"; exec "$REAL_HIPCC" "$@"; }

[ "${HIPCC_PARALLEL_OFF:-0}" = 1 ] && run_plain "disabled via HIPCC_PARALLEL_OFF" "$@"

# ------------------------------------------------------------ argument scan
declare -a ARCHS=()      # --offload-arch values, in the order given
declare -a BASE=()       # every other argument, offload-arch and -o removed
declare -a DEPFLAGS=()   # -MD/-MMD/-MF/-MT ... , given to the host compile only
OUTPUT=""
COMPILE_ONLY=0
NOT_A_COMPILE=""
HAVE_MT=0
HAVE_CUID=0

i=0; argv=("$@"); n=${#argv[@]}
while [ $i -lt $n ]; do
    a=${argv[$i]}
    case "$a" in
        --offload-arch=*|--cuda-gpu-arch=*|--amdgpu-target=*)
            ARCHS+=("${a#*=}") ;;
        --offload-arch|--cuda-gpu-arch|--amdgpu-target)
            i=$((i+1)); ARCHS+=("${argv[$i]}") ;;
        -o) i=$((i+1)); OUTPUT=${argv[$i]} ;;
        -o*) OUTPUT=${a#-o} ;;
        -c) COMPILE_ONLY=1; BASE+=("$a") ;;
        # an explicit cuid from the caller wins over the one we read from -###
        -cuid=*) HAVE_CUID=1; BASE+=("$a") ;;
        # preprocess / syntax-only / assembly: cheap and single-output, leave alone
        -E|-S|-fsyntax-only|--version|-M|-MM) NOT_A_COMPILE=$a; BASE+=("$a") ;;
        -MT|-MQ) HAVE_MT=1; DEPFLAGS+=("$a" "${argv[$((i+1))]}"); i=$((i+1)) ;;
        -MF) DEPFLAGS+=("$a" "${argv[$((i+1))]}"); i=$((i+1)) ;;
        -MD|-MMD) DEPFLAGS+=("$a") ;;
        # Compression applies to the bundle, not to the individual compiles.
        # Keeping it on the sub-compiles only earns an "argument unused" warning
        # per job; what the bundler needs is taken from the driver below.
        --offload-compress|--offload-compression-level=*) ;;
        # already splitting host/device by hand: do not interfere
        --offload-host-only|--offload-device-only|--cuda-host-only|--cuda-device-only)
            NOT_A_COMPILE=$a; BASE+=("$a") ;;
        *) BASE+=("$a") ;;
    esac
    i=$((i+1))
done

[ -n "$NOT_A_COMPILE" ]   && run_plain "$NOT_A_COMPILE is not a whole-TU object compile" "$@"
[ "$COMPILE_ONLY" -eq 1 ] || run_plain "not a -c compile (linking?)" "$@"
[ -n "$OUTPUT" ]          || run_plain "no explicit -o" "$@"
[ "${#ARCHS[@]}" -ge 2 ]  || run_plain "${#ARCHS[@]} architecture(s), nothing to parallelise" "$@"
NARCH=${#ARCHS[@]}

# -------------------------------------------------- ask the driver what to do
# Rather than reconstructing the bundler call, read it back from the driver:
# -### prints the commands it would run without running them.  From it we take
#   * the clang-offload-bundler that goes with THIS hipcc (the one in PATH may
#     belong to a different LLVM),
#   * the canonical -targets list, whose spelling and order we must reproduce,
#   * the compilation-unit id the driver picked.
# The cuid ties device-side static variables to the host code that registers
# them; every cc1 of one TU must share it.  Our host-only and device-only jobs
# have different command lines, and clang derives the cuid by hashing the
# command line (-fuse-cuid=hash), so each would otherwise invent its own.
DRV=$("$REAL_HIPCC" "$@" -### 2>&1)
BUNDLER=$(printf '%s\n' "$DRV" | grep -oE '"[^"]*clang-offload-bundler"' | head -1 | tr -d '"')
TARGETS=$(printf '%s\n' "$DRV" | grep -oE '"-targets=[^"]*"' | head -1 | tr -d '"')
TARGETS=${TARGETS#-targets=}
CUID=""
[ "$HAVE_CUID" -eq 0 ] && CUID=$(printf '%s\n' "$DRV" | grep -oE '"-cuid=[^"]*"' | head -1 | tr -d '"')

# Whatever compression the driver would apply to the bundle, apply the same.
# Do not hardcode -compress: in RDC mode this ROCm applies compression to the
# final fat binary at link time and passes nothing here, so inventing a flag
# would produce an object the plain driver never would.
declare -a BUNDLE_EXTRA=()
while IFS= read -r f; do [ -n "$f" ] && BUNDLE_EXTRA+=("$f"); done < <(
    printf '%s\n' "$DRV" | tr '"' '\n' | grep -E '^-(compress|compression-level=)' | sort -u)

[ -n "$BUNDLER" ] && [ -x "$BUNDLER" ] || run_plain "no usable clang-offload-bundler in -### output" "$@"
[ -n "$TARGETS" ]                     || run_plain "no -targets in -### output" "$@"

# Split the driver's target list and match each entry to one of our outputs.
# A device target ends in its architecture, e.g.
#   hip-amdgcn-amd-amdhsa-unknown-gfx90a:sramecc+   -> gfx90a:sramecc+
# gfx names never contain '-', so the arch is whatever follows the last '-'.
declare -a TGT=()
IFS=',' read -r -a TGT <<< "$TARGETS"
[ "${#TGT[@]}" -eq "$((NARCH + 1))" ] || run_plain "-### listed ${#TGT[@]} targets for $NARCH architectures" "$@"

arch_index() {  # $1 = arch string -> echoes its index in ARCHS, or nothing
    local k
    for ((k = 0; k < NARCH; k++)); do
        [ "${ARCHS[$k]}" = "$1" ] && { printf '%s' "$k"; return; }
    done
}

MAXJOBS=${HIPCC_PARALLEL_JOBS:-$NARCH}
[ "$MAXJOBS" -ge 1 ] 2>/dev/null || MAXJOBS=$NARCH
debug "bundler: $BUNDLER"
debug "targets: $TARGETS"
debug "cuid:    ${CUID:-<none>}"
debug "splitting $NARCH architectures (${ARCHS[*]}), max $MAXJOBS concurrent"

# ------------------------------------------------------------------ compile
TMPDIR_W=$(mktemp -d "${TMPDIR:-/tmp}/hipcc-parallel.XXXXXXXX") || exit 1

# ------------------------------------------------------- GNU Make jobserver
# make hands out one token per extra job slot.  The recipe running us already
# owns one slot, so we may always run a single job; every ADDITIONAL concurrent
# job needs a token, which we give back when we are done.
#
# Tokens are single bytes and losing one poisons the build for everyone, so the
# read must consume EXACTLY one byte.  bash's `read` may buffer ahead on a pipe,
# so `dd bs=1 count=1` is used instead, and each token is kept in its own file
# rather than a shell variable (a token byte may be NUL or otherwise unprintable).
JS_R=""; JS_W=""; JS_TOKENS=0
JS_TIMER=""          # pid of the wake-up sleeper, see the launch loop
JS_ACTIVE=0          # 1 once js_init has found a usable jobserver

js_init() {
    [ "${HIPCC_PARALLEL_JOBSERVER:-1}" = 0 ] && { debug "jobserver: disabled"; return 1; }
    local mf="${MAKEFLAGS:-}"
    [ -z "$mf" ] && mf="${CARGO_MAKEFLAGS:-}"
    [ -z "$mf" ] && { debug "jobserver: no MAKEFLAGS"; return 1; }

    # make >= 4.4 uses a named pipe; older makes pass an inherited fd pair.
    local fifo
    fifo=$(printf '%s' "$mf" | grep -oE -- '--jobserver-auth=fifo:[^ ]+' | head -1)
    if [ -n "$fifo" ]; then
        fifo=${fifo#--jobserver-auth=fifo:}
        [ -p "$fifo" ] || { debug "jobserver: '$fifo' is not a fifo"; return 1; }
        # open read-write so opening never blocks waiting for a writer
        exec {JS_R}<>"$fifo" || { debug "jobserver: cannot open $fifo"; return 1; }
        JS_W=$JS_R
        debug "jobserver: fifo $fifo"
        return 0
    fi

    local fds
    fds=$(printf '%s' "$mf" | grep -oE -- '--jobserver-(auth|fds)=[0-9]+,[0-9]+' | head -1)
    if [ -n "$fds" ]; then
        JS_R=${fds##*=}; JS_W=${JS_R#*,}; JS_R=${JS_R%%,*}
        # make only passes these fds to recipes it considers recursive (ones
        # marked with '+' or mentioning $(MAKE)).  Otherwise they are closed
        # here and must not be used - that is what hangs other implementations.
        if ! { : <&"$JS_R"; } 2>/dev/null || ! { : >&"$JS_W"; } 2>/dev/null; then
            debug "jobserver: fds $JS_R,$JS_W not inherited (recipe not marked '+')"
            JS_R=""; JS_W=""; return 1
        fi
        debug "jobserver: fds $JS_R,$JS_W"
        return 0
    fi
    debug "jobserver: no --jobserver-auth in MAKEFLAGS"
    return 1
}

# Try to take one token without blocking.  Returns 0 if one was acquired.
js_acquire() {
    [ -n "$JS_R" ] || return 1
    local f="$TMPDIR_W/token.$JS_TOKENS"
    dd bs=1 count=1 iflag=nonblock status=none <&"$JS_R" > "$f" 2>/dev/null
    if [ -s "$f" ]; then JS_TOKENS=$((JS_TOKENS+1)); return 0; fi
    rm -f "$f"; return 1
}

# Give every token back.  Must happen on every exit path, including signals.
js_release_all() {
    [ -n "$JS_W" ] || return 0
    local i
    for ((i = 0; i < JS_TOKENS; i++)); do
        [ -f "$TMPDIR_W/token.$i" ] && cat "$TMPDIR_W/token.$i" >&"$JS_W" 2>/dev/null
    done
    JS_TOKENS=0
}

# Take whatever the jobserver is willing to give right now, up to SLOTCAP.
# This is called once at the start and then again every JS_RETRY seconds for as
# long as there is a job still waiting for a slot.
js_topup() {
    local before=$SLOTS
    while [ "$SLOTS" -lt "$SLOTCAP" ] && js_acquire; do
        SLOTS=$((JS_TOKENS + 1))
    done
    [ "${1:-}" = quiet ] || [ "$SLOTS" -eq "$before" ] ||
        debug "jobserver: +$((SLOTS - before)) token(s) -> $SLOTS concurrent job(s) of $NJOBS"
    return 0
}

# Job NARCH is the host compile, jobs 0..NARCH-1 are the device compiles.
# Each gets its own directory: clang drops per-architecture temporaries next to
# its output, so this keeps concurrent jobs from colliding.
HOSTJOB=$NARCH
declare -a PIDS=() RC=()

# ------------------------------------------------------- signals / clean exit
# The sub-compiles must die with us.  Two things stand in the way:
#
#   * bash sets SIGINT and SIGQUIT to SIG_IGN in every '&' child of a
#     non-interactive shell, and an ignored disposition survives exec.  A Ctrl+C
#     delivered to make's process group therefore never reaches our jobs: make
#     and the wrapper die, hipcc/clang/cc1 keep compiling, orphaned.
#   * killing the hipcc we started is not enough either: it is a driver that
#     forks clang, which forks cc1.  Signalling only the direct child leaves the
#     grandchildren behind.
#
# So job control is enabled, which puts every job in its own process group (and
# stops bash from ignoring SIGINT on its behalf), and we signal that whole
# group.  Since the jobs are no longer in the terminal's foreground group they
# no longer get Ctrl+C by themselves - it is forwarded here instead.
JOBCTL=0
set -m 2>/dev/null && JOBCTL=1 || debug "job control unavailable: killing direct children only"

# $1 = signal name.  Sends it to each job's whole process group.
kill_jobs() {
    local sig=$1 j pid
    for ((j = 0; j < ${#PIDS[@]}; j++)); do
        pid=${PIDS[$j]:-}
        [ -n "$pid" ] || continue
        [ "$JOBCTL" -eq 1 ] && kill -"$sig" -- "-$pid" 2>/dev/null
        kill -"$sig" -- "$pid" 2>/dev/null
    done
    return 0
}

# Stop every job and do not return until they are really gone: the temporary
# directory must not be removed, and jobserver tokens must not be handed back,
# while a compile is still running.
terminate_jobs() {
    local sig=${1:-TERM} p wd n=0
    for p in ${PIDS[@]+"${PIDS[@]}"}; do [ -n "$p" ] && n=$((n+1)); done
    [ "$n" -gt 0 ] || return 0
    debug "terminating $n job(s) with SIG$sig"
    kill_jobs "$sig"
    # Insist if something declines to go away; clang exits on the first signal,
    # but we must not hang the build on anything that does not.
    ( sleep 2; kill_jobs KILL ) >/dev/null 2>&1 &
    wd=$!
    for p in "${PIDS[@]}"; do [ -n "$p" ] && wait "$p" 2>/dev/null; done
    [ "$JOBCTL" -eq 1 ] && kill -TERM -- "-$wd" 2>/dev/null
    kill -TERM -- "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
    PIDS=()
}

cleanup() {
    if [ -n "$JS_TIMER" ]; then kill "$JS_TIMER" 2>/dev/null; JS_TIMER=""; fi
    terminate_jobs TERM       # a no-op once the jobs have been reaped
    js_release_all            # only now: the tokens covered those jobs
    [ "${HIPCC_PARALLEL_DEBUG:-0}" = 1 ] || rm -rf "$TMPDIR_W"
}
trap cleanup EXIT

# $1 = the signal we caught.  Pass it on, clean up, then die from it ourselves
# so make sees an interrupted recipe rather than an ordinary failure.
on_signal() {
    trap - INT TERM HUP QUIT EXIT     # a second Ctrl+C must not re-enter this
    terminate_jobs "$1"
    js_release_all
    [ "${HIPCC_PARALLEL_DEBUG:-0}" = 1 ] || rm -rf "$TMPDIR_W"
    kill -"$1" -- "$$" 2>/dev/null
    exit $((128 + $(kill -l "$1" 2>/dev/null || echo 15)))
}
trap 'on_signal INT'  INT
trap 'on_signal TERM' TERM
trap 'on_signal HUP'  HUP
trap 'on_signal QUIT' QUIT

# Ctrl+Z used to stop the compiles along with the rest of the foreground group;
# now that they have groups of their own, suspend and resume them by hand.
on_stop() {
    kill_jobs STOP
    trap - TSTP; kill -STOP -- "$$" 2>/dev/null; trap on_stop TSTP
}
trap on_stop TSTP
trap 'kill_jobs CONT' CONT

launch() {
    local idx=$1
    local d="$TMPDIR_W/$idx"
    mkdir -p "$d"
    local -a args=("${BASE[@]}")
    [ -n "$CUID" ] && args+=("$CUID")
    if [ "$idx" -eq "$HOSTJOB" ]; then
        # Pass the full architecture list even though this compiles host code
        # only: it is what the driver does, and without it the driver tries to
        # detect a local GPU (rocm_agent_enumerator) on every host compile.
        args+=(--offload-host-only)
        local a
        for a in "${ARCHS[@]}"; do args+=("--offload-arch=$a"); done
        args+=(-o "$d/host.o")
        # The dependency file is a property of the host compilation.  Without
        # -MT its rule target would be our private temporary object and make
        # would never match it against the real one.
        if [ "${#DEPFLAGS[@]}" -gt 0 ]; then
            args+=("${DEPFLAGS[@]}")
            [ "$HAVE_MT" -eq 0 ] && args+=(-MT "$OUTPUT")
        fi
    else
        args+=(--offload-device-only "--offload-arch=${ARCHS[$idx]}" -o "$d/dev.bc")
    fi
    # No stdin: with job control on, a background group that reads the
    # terminal is stopped by SIGTTIN, and a compile has nothing to read anyway.
    "$REAL_HIPCC" "${args[@]}" < /dev/null > "$d/log" 2>&1 &
    PIDS[$idx]=$!
}

NJOBS=$((NARCH + 1))

# How many of those may run at once.  Start from the user's cap (+1 for the host
# job, which is what MAXJOBS has always meant here), then, if a jobserver is
# present, lower it to what the jobserver actually grants: one implicit slot we
# already own plus one per token we manage to take.
SLOTCAP=$((MAXJOBS + 1))
[ "$SLOTCAP" -gt "$NJOBS" ] && SLOTCAP=$NJOBS
SLOTS=$SLOTCAP
# How often to ask the jobserver for another token while a job is still
# waiting for a slot.  0 disables the retry.
JS_RETRY=${HIPCC_PARALLEL_JOBSERVER_RETRY:-10}
[ "$JS_RETRY" -ge 0 ] 2>/dev/null || JS_RETRY=10
if js_init; then
    JS_ACTIVE=1
    SLOTS=1                   # the implicit slot the recipe already owns
    js_topup quiet
    debug "jobserver: $JS_TOKENS token(s) -> $SLOTS concurrent job(s) of $NJOBS" \
          "(re-checking every ${JS_RETRY}s)"
else
    # No usable jobserver.  make only starts one for -j with N > 1, so a plain
    # '-j1' (or fds we were not given) would otherwise leave us running every
    # architecture at once - the opposite of what -j1 asks for.  Fall back to
    # the -jN in MAKEFLAGS when it names a number; a bare '-j' means unlimited.
    jn=$(printf '%s' "${MAKEFLAGS:-}" | grep -oE -- '-j[0-9]+' | head -1)
    jn=${jn#-j}
    if [ -n "$jn" ] && [ "$jn" -ge 1 ] 2>/dev/null && [ "$jn" -lt "$SLOTS" ]; then
        SLOTS=$jn
        debug "no jobserver: capped to -j$jn from MAKEFLAGS -> $SLOTS of $NJOBS"
    else
        debug "no jobserver: $SLOTS concurrent job(s) of $NJOBS"
    fi
fi

running=0; next=0
while [ "$next" -lt "$NJOBS" ] || [ "$running" -gt 0 ]; do
    # Anything still queued?  Ask the jobserver again before deciding.
    waiting=0
    [ "$next" -lt "$NJOBS" ] && [ "$SLOTS" -lt "$SLOTCAP" ] && waiting=1
    [ "$JS_ACTIVE" -eq 1 ] && [ "$waiting" -eq 1 ] && js_topup
    while [ "$next" -lt "$NJOBS" ] && [ "$running" -lt "$SLOTS" ]; do
        launch "$next"; next=$((next+1)); running=$((running+1))
    done
    # Recompute: launching may have used up the slack we just acquired.
    waiting=0
    [ "$next" -lt "$NJOBS" ] && [ "$SLOTS" -lt "$SLOTCAP" ] && waiting=1
    if [ "$JS_ACTIVE" -eq 1 ] && [ "$waiting" -eq 1 ] && [ "$JS_RETRY" -gt 0 ]; then
        # Wait for a job to finish OR for the retry interval to elapse,
        # whichever comes first.  bash has no timeout on `wait`, so a sleeper
        # is put in the same job pool and `wait -n` returns for either.
        sleep "$JS_RETRY" & JS_TIMER=$!
        wait -n 2>/dev/null
        kill "$JS_TIMER" 2>/dev/null; wait "$JS_TIMER" 2>/dev/null; JS_TIMER=""
    else
        wait -n 2>/dev/null
    fi
    running=0
    for ((j = 0; j < next; j++)); do
        kill -0 "${PIDS[$j]}" 2>/dev/null && running=$((running+1))
    done
done

failed=0
for ((j = 0; j < NJOBS; j++)); do
    wait "${PIDS[$j]}"; RC[$j]=$?
    # Forget the pid once reaped: the OS may hand it to somebody else, and
    # cleanup() must never signal a process group that is no longer ours.
    PIDS[$j]=""
    [ "${RC[$j]}" -ne 0 ] && failed=1
done

# ------------------------------------------------------- diagnostics replay
# Host diagnostics come from the host job; each device job reports only what it
# saw for its own architecture, so there is no duplication to filter here --
# unlike the host-repeated-N-times scheme this replaces.  Still de-duplicate by
# default, since the device jobs re-parse the same headers.
cat "$TMPDIR_W/$HOSTJOB/log" >&2
for ((j = 0; j < NARCH; j++)); do
    [ -s "$TMPDIR_W/$j/log" ] || continue
    if [ "${HIPCC_PARALLEL_DEDUP:-1}" = 0 ]; then
        sed "s|^|[${ARCHS[$j]}] |" "$TMPDIR_W/$j/log" >&2
    else
        grep -vxF -f "$TMPDIR_W/$HOSTJOB/log" -- "$TMPDIR_W/$j/log" 2>/dev/null \
            | sed "s|^|[${ARCHS[$j]}] |" >&2
    fi
done

if [ "$failed" -ne 0 ]; then
    for ((j = 0; j < NARCH; j++)); do
        [ "${RC[$j]}" -ne 0 ] && warn "device compilation failed for ${ARCHS[$j]} (exit ${RC[$j]})"
    done
    [ "${RC[$HOSTJOB]}" -ne 0 ] && warn "host compilation failed (exit ${RC[$HOSTJOB]})"
    exit 1
fi

# -------------------------------------------------------------------- bundle
# Feed the inputs in the driver's own target order.
declare -a BARGS=(-type=o "-targets=$TARGETS")
[ "${#BUNDLE_EXTRA[@]}" -gt 0 ] && BARGS+=("${BUNDLE_EXTRA[@]}")
for t in "${TGT[@]}"; do
    if [ "${t#host-}" != "$t" ]; then
        BARGS+=("-input=$TMPDIR_W/$HOSTJOB/host.o")
    else
        idx=$(arch_index "${t##*-}")
        # exec replaces this shell, so the EXIT trap would never run: hand the
        # jobserver tokens back and drop the temporaries before leaving.
        [ -n "$idx" ] || { warn "target '$t' matches no --offload-arch; falling back"; cleanup; trap - EXIT; exec "$REAL_HIPCC" "$@"; }
        BARGS+=("-input=$TMPDIR_W/$idx/dev.bc")
    fi
done
BARGS+=("-output=$OUTPUT")

if ! "$BUNDLER" "${BARGS[@]}"; then
    warn "clang-offload-bundler failed; falling back to a single serial compile"
    cleanup; trap - EXIT
    exec "$REAL_HIPCC" "$@"
fi

debug "wrote $OUTPUT from $NARCH device objects + 1 host object"
exit 0
